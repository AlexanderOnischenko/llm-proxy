#!/usr/bin/env bash
set -euo pipefail

# llm-proxy — local helper for managing LLM Proxy docker container + env profiles.
# Profiles/caches live under $HOME (XDG dirs by default). install/uninstall/reinstall never delete them.

PROG="llm-proxy"

die() { echo "$PROG: $*" >&2; exit 1; }
warn() { echo "$PROG: $*" >&2; }
is_macos() { [[ "${OSTYPE:-}" == "darwin"* ]]; }

# ---------------------------
# Paths (XDG + legacy support)
# ---------------------------
resolve_home() {
  if [[ -n "${LLM_PROXY_HOME:-}" ]]; then
    echo "${LLM_PROXY_HOME}"
    return
  fi
  # Legacy: if ~/.llm-proxy exists, keep using it to avoid breaking existing installs.
  if [[ -d "${HOME}/.llm-proxy" ]]; then
    echo "${HOME}/.llm-proxy"
    return
  fi
  echo ""
}

resolve_dirs() {
  local legacy_home
  legacy_home="$(resolve_home)"

  if [[ -n "$legacy_home" ]]; then
    CONFIG_DIR="${legacy_home}/config"
    DATA_DIR="${legacy_home}/data"
    CACHE_DIR="${legacy_home}/cache"
  else
    CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/${PROG}"
    DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/${PROG}"
    CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/${PROG}"
  fi

  PROFILES_DIR="${CONFIG_DIR}/profiles"
  ACTIVE_FILE="${CONFIG_DIR}/active_profile"

  # Per-profile "owned" dirs we can safely delete on profile delete:
  PROFILE_DATA_ROOT="${DATA_DIR}/profiles"
  PROFILE_LOG_ROOT="${DATA_DIR}/logs"
  PROFILE_CACHE_ROOT="${CACHE_DIR}/profiles"
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$CACHE_DIR" "$PROFILES_DIR"            "$PROFILE_DATA_ROOT" "$PROFILE_LOG_ROOT" "$PROFILE_CACHE_ROOT"
}

sanitize_profile_name() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  if [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "$name"
    return 0
  fi
  return 1
}

profile_env_path() {
  local name="$1"
  echo "${PROFILES_DIR}/${name}.env"
}

profile_owned_dirs() {
  local name="$1"
  echo "${PROFILE_DATA_ROOT}/${name}"$'\n'"${PROFILE_LOG_ROOT}/${name}"$'\n'"${PROFILE_CACHE_ROOT}/${name}"
}

get_active_profile() {
  if [[ -f "$ACTIVE_FILE" ]]; then
    sed -n '1p' "$ACTIVE_FILE" | tr -d '[:space:]'
  else
    echo ""
  fi
}

set_active_profile() {
  local name="$1"
  printf '%s\n' "$name" > "$ACTIVE_FILE"
}

clear_active_profile() {
  rm -f "$ACTIVE_FILE"
}

list_profiles() {
  local f
  shopt -s nullglob
  for f in "${PROFILES_DIR}/"*.env; do
    basename "$f" .env
  done
  shopt -u nullglob
}

# ---------------------------
# Template & editing
# ---------------------------
profile_template() {
  cat <<'EOF'
# LLM Proxy profile (.env)
# Заполни значения справа. Комментарии можно оставлять.
# Формат: KEY=value

# --- Upstream provider ---
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=CHANGEME
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT=300
LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_MAX_TOKENS=50000
LLM_VERBOSE=true

# --- TLS / mTLS (опционально) ---
# LLM_VERIFY_SSL_CERTS=true
# LLM_CA_BUNDLE_FILE=
# LLM_CERT_FILE=
# LLM_KEY_FILE=
# LLM_KEY_FILE_PASSWORD=

# --- GigaChat (если LLM_PROVIDER=gigachat) ---
# LLM_SCOPE=
# LLM_AUTH_URL=

# --- Queue / priorities ---
LLM_MAX_CONCURRENT=1
LLM_QUEUE_MAX_LEN=100
LLM_PRIORITY_DEFAULT=p2
LLM_PRIORITY_SLOTS_P1=2
LLM_PRIORITY_SLOTS_P2=1
LLM_PRIORITY_SLOTS_P3=1

# --- Cache (обычно достаточно) ---
LLM_CACHE_ENABLED=true
# Если LLM_CACHE_PATH не задан, будет использовано: CACHE_CONTAINER_DIR + LLM_CACHE_FILE
CACHE_CONTAINER_DIR=/home/appuser/app/cache
# Если LLM_LOG_DIR не задан, будет использовано: /logs
LLM_LOG_DIR=/logs
LLM_CACHE_FILE=llm_cache.sqlite
LLM_CACHE_TTL=600000

# --- Service runtime ---
LOG_LEVEL=INFO
ENV=development
TESTING=false
LLM_PORT=8002

# --- Docker (управляется CLI) ---
LLM_PROXY_IMAGE=backplane/llm:latest
# LLM_HOST_PORT=8002

EOF
}

ensure_profile_prefilled() {
  local name="$1"
  local file
  file="$(profile_env_path "$name")"
  if [[ -f "$file" ]]; then
    return
  fi
  mkdir -p "$(dirname "$file")"
  profile_template > "$file"

  while IFS= read -r d; do
    mkdir -p "$d"
  done < <(profile_owned_dirs "$name")
}

run_editor() {
  local file="$1"

  if [[ -n "${LLM_PROXY_EDITOR:-}" ]]; then
    eval "${LLM_PROXY_EDITOR} \"${file}\""
    return
  fi

  if [[ -n "${EDITOR:-}" ]]; then
    eval "${EDITOR} \"${file}\""
    return
  fi

  if is_macos; then
    /usr/bin/open -W -a "TextEdit" "$file"
  else
    command -v nano >/dev/null 2>&1 || die "nano not found; set EDITOR or LLM_PROXY_EDITOR"
    nano "$file"
  fi
}

# ---------------------------
# Docker helpers
# ---------------------------
docker_available() {
  command -v docker >/dev/null 2>&1
}

require_docker() {
  docker_available || die "docker not found"
}

read_env_value() {
  local key="$1"
  local file="$2"
  awk -F= -v k="$key" '
    $0 ~ "^[[:space:]]*#" {next}
    $0 ~ "^[[:space:]]*$" {next}
    $1 == k {sub(/^[^=]*=/,""); print; exit}
  ' "$file" 2>/dev/null || true
}

container_name_for_profile() {
  local name="$1"
  echo "${PROG}-${name}"
}

docker_stop_rm_name_best_effort() {
  local cname="$1"
  local notice="${2:-}"
  docker_available || return 0

  if ! docker ps -a --format '{{.Names}}' | grep -Fxq "$cname"; then
    return 0
  fi

  if docker rm -f "$cname" >/dev/null 2>&1; then
    if [[ -n "$notice" ]]; then
      echo "${notice}: $cname"
    fi
  else
    warn "не удалось погасить контейнер: $cname (best-effort)"
  fi
}

docker_stop_profile_best_effort() {
  local name="$1"
  local notice="${2:-}"
  docker_stop_rm_name_best_effort "$(container_name_for_profile "$name")" "$notice"
}

docker_stop_all_llm_proxy_containers_best_effort() {
  docker_available || return 0
  local cname
  while IFS= read -r cname; do
    [[ -n "$cname" ]] || continue
    docker_stop_rm_name_best_effort "$cname" "Погасили старый контейнер"
  done < <(docker ps -a --filter "name=^/${PROG}-" --format '{{.Names}}')
}

docker_start_profile() {
  local name="$1"
  local env_file image llm_port host_port cache_container_dir cache_root logs_root cname

  env_file="$(profile_env_path "$name")"
  [[ -f "$env_file" ]] || die "profile not found: $name"

  image="$(read_env_value "LLM_PROXY_IMAGE" "$env_file")"
  [[ -n "$image" ]] || image="llm-proxy:latest"

  llm_port="$(read_env_value "LLM_PORT" "$env_file")"
  [[ -n "$llm_port" ]] || llm_port="8002"

  host_port="$(read_env_value "LLM_HOST_PORT" "$env_file")"
  [[ -n "$host_port" ]] || host_port="$llm_port"

  cache_container_dir="$(read_env_value "CACHE_CONTAINER_DIR" "$env_file")"
  [[ -n "$cache_container_dir" ]] || cache_container_dir="home/appuser/app/cache"

  log_container_dir="$(read_env_value "LOG_CONTAINER_DIR" "$env_file")"
  [[ -n "$log_container_dir" ]] || log_container_dir="/logs"

  cname="$(container_name_for_profile "$name")"
  cache_root="${PROFILE_CACHE_ROOT}/${name}"
  logs_root="${PROFILE_LOG_ROOT}/${name}"

  mkdir -p "$cache_root" "$logs_root"

  require_docker

  # DX rule: only one llm-proxy container at a time (avoid port conflicts).
  docker_stop_all_llm_proxy_containers_best_effort

  docker run -d     --name "$cname"     --env-file "$env_file"     -p "${host_port}:${llm_port}"     -v "${cache_root}:${cache_container_dir}"     -v "${logs_root}:/home/appuser/app/logs"     "$image" >/dev/null

  echo "Started: $cname (image=$image, host_port=$host_port -> container_port=$llm_port)"
}

docker_stop_profile() {
  local name="$1"
  local cname
  cname="$(container_name_for_profile "$name")"
  require_docker
  if docker ps -a --format '{{.Names}}' | grep -Fxq "$cname"; then
    docker_stop_rm_name_best_effort "$cname" "Остановили контейнер"
  else
    echo "Контейнер не найден: $cname (ничего не остановлено)"
  fi
}

docker_status_profile() {
  local name="$1"
  local cname
  cname="$(container_name_for_profile "$name")"
  require_docker
  if docker ps --format '{{.Names}}' | grep -Fxq "$cname"; then
    echo "running: $cname"
    docker ps --filter "name=^/${cname}$" --format '  {{.Names}}  {{.Image}}  {{.Ports}}'
  elif docker ps -a --format '{{.Names}}' | grep -Fxq "$cname"; then
    echo "stopped: $cname"
  else
    echo "not created: $cname"
  fi
}

# ---------------------------
# UX
# ---------------------------
confirm() {
  local prompt="$1"
  local assume="${2:-}"
  if [[ "${LLM_PROXY_ASSUME_YES:-}" == "1" ]]; then
    return 0
  fi
  if [[ "$assume" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    die "refusing to prompt on non-interactive stdin; pass --yes"
  fi
  read -r -p "$prompt [y/N] " ans || true
  [[ "${ans:-}" == "y" || "${ans:-}" == "Y" ]]
}

usage() {
  cat <<EOF
$PROG — manage LLM Proxy profiles and docker runtime

Usage:
  $PROG help
  $PROG list
  $PROG active
  $PROG create <name>
  $PROG edit [name]
  $PROG use <name>
  $PROG start [name]
  $PROG stop [name]
  $PROG status [name]
  $PROG delete <name> [--yes]

User install (no sudo):
  $PROG install
  $PROG uninstall
  $PROG reinstall

Examples:
  $PROG create openrouter  # создать профиль
  $PROG edit openrouter    # редактировать
  $PROG use openrouter     # сделать активным (остановит старый контейнер, если он был активным)
  $PROG start              # запустить активный профиль (перед запуском остановит все llm-proxy-* контейнеры)
  $PROG start llm7         # переключиться на профиль и запустить (аналог: use+start)

Notes:
  - По умолчанию редактор на macOS: TextEdit.
    Можно переопределить: LLM_PROXY_EDITOR="code --wait" или EDITOR="open -e"
  - На macOS PATH часто задаётся в login-shell файлах: ~/.zprofile или ~/.bash_profile
EOF
}

# ---------------------------
# User install helpers
# ---------------------------
path_has_dir() {
  local d="$1"
  case ":${PATH}:" in
    *":${d}:"*) return 0 ;;
    *) return 1 ;;
  esac
}

append_path_export_once() {
  local rc="$1"
  local marker="# llm-proxy: add ~/.local/bin to PATH"
  local line='export PATH="$HOME/.local/bin:$PATH"'

  touch "$rc" 2>/dev/null || true
  if grep -Fq "$line" "$rc" 2>/dev/null; then
    return 0
  fi
  {
    echo ""
    echo "$marker"
    echo "$line"
  } >> "$rc"
}

ensure_local_bin_in_path() {
  local bin_dir="${HOME}/.local/bin"
  if path_has_dir "$bin_dir"; then
    return 0
  fi

  local shell="${SHELL:-}"
  if [[ "$shell" == */zsh ]]; then
    append_path_export_once "${HOME}/.zprofile"
    append_path_export_once "${HOME}/.zshrc"
  elif [[ "$shell" == */bash ]]; then
    append_path_export_once "${HOME}/.bash_profile"
    append_path_export_once "${HOME}/.bashrc"
  else
    append_path_export_once "${HOME}/.zprofile"
    append_path_export_once "${HOME}/.zshrc"
    append_path_export_once "${HOME}/.bash_profile"
    append_path_export_once "${HOME}/.bashrc"
  fi

  warn "~/.local/bin is not currently in PATH."
  warn "I added an export line to your shell rc. Open a new terminal or run:"
  warn '  export PATH="$HOME/.local/bin:$PATH"'
}

cmd_install() {
  local bin_dir="${HOME}/.local/bin"
  local target="${bin_dir}/${PROG}"
  mkdir -p "$bin_dir"
  install -m 0755 "$0" "$target"
  echo "Installed to $target"
  ensure_local_bin_in_path
}

cmd_uninstall() {
  local target="${HOME}/.local/bin/${PROG}"
  rm -f "$target"
  echo "Removed $target"
}

cmd_reinstall() {
  cmd_uninstall
  cmd_install
}

# ---------------------------
# Commands
# ---------------------------
main() {
  resolve_dirs
  ensure_dirs

  local cmd="${1:-help}"
  shift || true

  if [[ "$cmd" == "profile" || "$cmd" == "profiles" ]]; then
    cmd="${1:-help}"
    shift || true
  fi

  case "$cmd" in
    help|-h|--help) usage ;;
    list|ls) list_profiles ;;
    active)
      local a; a="$(get_active_profile)"
      [[ -n "$a" ]] && echo "$a" || die "no active profile (use: $PROG use <name>)"
      ;;
    create)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: $PROG create <name>"
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"; echo "Created: $name"
      ;;
    edit)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG edit <name> or $PROG use <name>"
      fi
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"; run_editor "$(profile_env_path "$name")"
      ;;
    use|switch)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: $PROG use <name>"
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"

      local current; current="$(get_active_profile)"
      if [[ -n "$current" && "$current" == "$name" ]]; then
        echo "Active: $name (unchanged)"
        exit 0
      fi

      # DX rule: if switching profiles, stop old active container (best-effort).
      if [[ -n "$current" ]]; then
        docker_stop_profile_best_effort "$current" "Погасили контейнер активного профиля перед переключением"
      fi

      set_active_profile "$name"
      echo "Active: $name"
      ;;
    start|up|run)
      local requested="${1:-}"
      local current; current="$(get_active_profile)"
      local name

      if [[ -n "$requested" ]]; then
        name="$(sanitize_profile_name "$requested")" || die "invalid profile name (use letters/digits/._-)"
        ensure_profile_prefilled "$name"
        if [[ -n "$current" && "$current" != "$name" ]]; then
          docker_stop_profile_best_effort "$current" "Погасили контейнер предыдущего профиля перед запуском нового"
        fi
        set_active_profile "$name"
      else
        name="$current"
        [[ -n "$name" ]] || die "no active profile; use: $PROG use <name>"
      fi

      docker_start_profile "$name"
      ;;
    stop|down)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG stop <name>"
      else
        name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      fi
      docker_stop_profile "$name"
      ;;
    status)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG status <name>"
      else
        name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      fi
      docker_status_profile "$name"
      ;;
    delete|rm|remove)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: $PROG delete <name> [--yes]"
      shift || true
      local assume_yes="0"
      [[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && assume_yes="1"

      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      local env_file; env_file="$(profile_env_path "$name")"
      [[ -f "$env_file" ]] || die "profile not found: $name"

      if ! confirm "Delete profile '$name' and its profile-owned data (logs/cache)?" "$assume_yes"; then
        echo "Cancelled."; exit 0
      fi

      local active; active="$(get_active_profile)"
      if [[ "$active" == "$name" ]]; then
        docker_stop_profile_best_effort "$name"
        clear_active_profile
      else
        docker_stop_profile_best_effort "$name"
      fi

      rm -f "$env_file"
      while IFS= read -r d; do [[ -d "$d" ]] && rm -rf "$d"; done < <(profile_owned_dirs "$name")
      echo "Deleted: $name"
      ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    reinstall) cmd_reinstall ;;
    *)
      usage
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
