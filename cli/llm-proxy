#!/usr/bin/env bash
set -euo pipefail

# llm-proxy — manage LLM Proxy profiles + docker compose runtime.
# Profiles live under $HOME (XDG dirs by default). Repo stays clean.

PROG="llm-proxy"

die() { echo "$PROG: $*" >&2; exit 1; }
warn() { echo "$PROG: $*" >&2; }
is_macos() { [[ "${OSTYPE:-}" == "darwin"* ]]; }

# ---------------------------
# Paths (XDG + legacy support)
# ---------------------------
resolve_home() {
  if [[ -n "${LLM_PROXY_HOME:-}" ]]; then
    echo "${LLM_PROXY_HOME}"
    return
  fi
  # Legacy: if ~/.llm-proxy exists, keep using it to avoid breaking existing installs.
  if [[ -d "${HOME}/.llm-proxy" ]]; then
    echo "${HOME}/.llm-proxy"
    return
  fi
  echo ""
}

resolve_dirs() {
  local legacy_home
  legacy_home="$(resolve_home)"

  if [[ -n "$legacy_home" ]]; then
    CONFIG_DIR="${legacy_home}/config"
    DATA_DIR="${legacy_home}/data"
    CACHE_DIR="${legacy_home}/cache"
  else
    CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/${PROG}"
    DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/${PROG}"
    CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/${PROG}"
  fi

  PROFILES_DIR="${CONFIG_DIR}/profiles"
  ACTIVE_FILE="${CONFIG_DIR}/active_profile"

  # Per-profile "owned" dirs we can safely delete on profile delete:
  PROFILE_DATA_ROOT="${DATA_DIR}/profiles"
  PROFILE_LOG_ROOT="${DATA_DIR}/logs"
  PROFILE_CACHE_ROOT="${CACHE_DIR}/profiles"
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$CACHE_DIR" "$PROFILES_DIR" \
           "$PROFILE_DATA_ROOT" "$PROFILE_LOG_ROOT" "$PROFILE_CACHE_ROOT"
}

sanitize_profile_name() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  if [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "$name"
    return 0
  fi
  return 1
}

profile_compose_env_path() {
  local name="$1"
  echo "${PROFILES_DIR}/${name}.env"
}

profile_runtime_env_path() {
  local name="$1"
  echo "${PROFILES_DIR}/${name}.llm.env"
}

profile_owned_dirs() {
  local name="$1"
  echo "${PROFILE_DATA_ROOT}/${name}"$'\n'"${PROFILE_LOG_ROOT}/${name}"$'\n'"${PROFILE_CACHE_ROOT}/${name}"
}

get_active_profile() {
  if [[ -f "$ACTIVE_FILE" ]]; then
    sed -n '1p' "$ACTIVE_FILE" | tr -d '[:space:]'
  else
    echo ""
  fi
}

set_active_profile() {
  local name="$1"
  printf '%s\n' "$name" > "$ACTIVE_FILE"
}

clear_active_profile() {
  rm -f "$ACTIVE_FILE"
}

list_profiles() {
  local f
  shopt -s nullglob
  for f in "${PROFILES_DIR}/"*.env; do
    basename "$f" .env
  done
  shopt -u nullglob
}

# ---------------------------
# Project dir (where compose.yaml lives)
# ---------------------------
resolve_project_dir() {
  # 1) explicit override
  if [[ -n "${LLM_PROXY_PROJECT_DIR:-}" ]]; then
    [[ -f "${LLM_PROXY_PROJECT_DIR}/compose.yaml" ]] || die "compose.yaml not found in LLM_PROXY_PROJECT_DIR=${LLM_PROXY_PROJECT_DIR}"
    echo "${LLM_PROXY_PROJECT_DIR}"
    return
  fi

  # 2) current working dir
  if [[ -f "${PWD}/compose.yaml" ]]; then
    echo "${PWD}"
    return
  fi

  # 3) relative to script location (works when running from repo checkout)
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -f "${here}/compose.yaml" ]]; then
    echo "${here}"
    return
  fi

  die "cannot locate compose.yaml. Run from repo root, or set LLM_PROXY_PROJECT_DIR=/path/to/repo"
}

# ---------------------------
# Template & editing
# ---------------------------
runtime_env_template() {
  cat <<'EOF'
# Runtime env for llm-proxy (matches llm/config/settings.py)

# Service
LOG_LEVEL=INFO
ENV=development
TESTING=false

# Upstream LLM
LLM_API_BASE=https://api.llm7.io/v1
LLM_API_KEY=unused
LLM_MODEL_NAME=deepseek-v3-0324
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=50000
LLM_VERBOSE=true
LLM_TIMEOUT=300.0

# Concurrency / queue
LLM_MAX_CONCURRENT=1
LLM_QUEUE_MAX_LEN=100
LLM_PRIORITY_DEFAULT=p2

# Prefer map-based config (JSON string).
LLM_PRIORITY_SLOTS={"p1":2,"p2":1,"p3":1}

# Legacy fallback (used only if LLM_PRIORITY_SLOTS is not explicitly set)
# LLM_PRIORITY_SLOTS_P1=2
# LLM_PRIORITY_SLOTS_P2=1
# LLM_PRIORITY_SLOTS_P3=1

# Cache
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=600000
CACHE_CONTAINER_DIR=/cache
LLM_CACHE_FILE=llm_cache.sqlite
# If LLM_CACHE_PATH is explicitly set -> it has priority.
# LLM_CACHE_PATH=/cache/llm_cache.sqlite
EOF
}

compose_env_template() {
  local name="$1"
  local cache_root logs_root dumps_root runtime_env
  cache_root="${PROFILE_CACHE_ROOT}/${name}"
  logs_root="${PROFILE_LOG_ROOT}/${name}"
  dumps_root="${PROFILE_DATA_ROOT}/${name}/crash_dumps"
  runtime_env="$(profile_runtime_env_path "$name")"

  cat <<EOF
# Compose substitution env for profile: ${name}

# Image/build
LLM_IMAGE=backplane/llm:latest
LLM_BUILD_CONTEXT=.
LLM_DOCKERFILE=Dockerfile

# Ports
LLM_PORT=8002

# Mounts (host)
CACHE_HOST_DIR=${cache_root}
LOGS_HOST_DIR=${logs_root}
DUMP_HOST_DIR=${dumps_root}

# Mounts (container)
CACHE_CONTAINER_DIR=/cache
LOGS_CONTAINER_DIR=/logs
DUMP_CONTAINER_DIR=/crash_dumps

# Runtime env file for the service (absolute path is OK for compose)
LLM_ENV_FILE=${runtime_env}

# Optional
LOG_LEVEL=INFO
EOF
}

run_editor() {
  local file="$1"

  if [[ -n "${LLM_PROXY_EDITOR:-}" ]]; then
    eval "${LLM_PROXY_EDITOR} \"${file}\""
    return
  fi

  if [[ -n "${EDITOR:-}" ]]; then
    eval "${EDITOR} \"${file}\""
    return
  fi

  if is_macos; then
    /usr/bin/open -W -a "TextEdit" "$file"
  else
    command -v nano >/dev/null 2>&1 || die "nano not found; set EDITOR or LLM_PROXY_EDITOR"
    nano "$file"
  fi
}

ensure_profile_prefilled() {
  local name="$1"
  local compose_file runtime_file

  compose_file="$(profile_compose_env_path "$name")"
  runtime_file="$(profile_runtime_env_path "$name")"

  mkdir -p "$(dirname "$compose_file")"

  # owned dirs
  mkdir -p "${PROFILE_CACHE_ROOT}/${name}" "${PROFILE_LOG_ROOT}/${name}" "${PROFILE_DATA_ROOT}/${name}/crash_dumps"

  if [[ ! -f "$runtime_file" ]]; then
    runtime_env_template > "$runtime_file"
  fi

  if [[ ! -f "$compose_file" ]]; then
    compose_env_template "$name" > "$compose_file"
  fi
}

# ---------------------------
# Docker compose helpers
# ---------------------------
docker_available() { command -v docker >/dev/null 2>&1; }
require_docker() { docker_available || die "docker not found"; }

compose_cmd() {
  local name="$1"; shift
  local project_dir compose_env project_name
  project_dir="$(resolve_project_dir)"
  compose_env="$(profile_compose_env_path "$name")"
  [[ -f "$compose_env" ]] || die "profile not found: $name"
  project_name="${PROG}-${name}"

  require_docker
  docker compose \
    --project-directory "$project_dir" \
    -f "${project_dir}/compose.yaml" \
    --env-file "$compose_env" \
    -p "$project_name" \
    "$@"
}

compose_up() {
  local name="$1"
  compose_cmd "$name" up -d --build --remove-orphans
  echo "Started: ${PROG}-${name}"
}

compose_down_best_effort() {
  local name="$1"
  docker_available || return 0
  compose_cmd "$name" down --remove-orphans >/dev/null 2>&1 || true
}

compose_status() {
  local name="$1"
  compose_cmd "$name" ps
}

compose_logs() {
  local name="$1"
  compose_cmd "$name" logs -f --tail=200
}

# ---------------------------
# UX
# ---------------------------
confirm() {
  local prompt="$1"
  local assume="${2:-}"
  if [[ "${LLM_PROXY_ASSUME_YES:-}" == "1" ]]; then
    return 0
  fi
  if [[ "$assume" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    die "refusing to prompt on non-interactive stdin; pass --yes"
  fi
  read -r -p "$prompt [y/N] " ans || true
  [[ "${ans:-}" == "y" || "${ans:-}" == "Y" ]]
}

usage() {
  cat <<EOF
$PROG — manage llm-proxy profiles and docker compose runtime

Usage:
  $PROG help
  $PROG list
  $PROG active
  $PROG init [name]          # create + use + open editor for runtime env (first-run friendly)
  $PROG create <name>
  $PROG use <name>
  $PROG edit [name]          # edit runtime env (<name>.llm.env)
  $PROG edit-compose [name]  # edit compose env (<name>.env)
  $PROG up [name]            # start active or provided profile (compose up -d --build)
  $PROG down [name]          # stop active or provided profile (compose down)
  $PROG status [name]
  $PROG logs [name]
  $PROG delete <name> [--yes]

Optional:
  $PROG install|uninstall|reinstall

Project directory:
  - Run from repo root (where compose.yaml is), OR set:
      LLM_PROXY_PROJECT_DIR=/path/to/repo

Examples:
  $PROG init default
  $PROG up
  $PROG logs
EOF
}

# ---------------------------
# User install helpers
# ---------------------------
path_has_dir() {
  local d="$1"
  case ":${PATH}:" in
    *":${d}:"*) return 0 ;;
    *) return 1 ;;
  esac
}

append_path_export_once() {
  local rc="$1"
  local marker="# llm-proxy: add ~/.local/bin to PATH"
  local line='export PATH="$HOME/.local/bin:$PATH"'

  touch "$rc" 2>/dev/null || true
  if grep -Fq "$line" "$rc" 2>/dev/null; then
    return 0
  fi
  {
    echo ""
    echo "$marker"
    echo "$line"
  } >> "$rc"
}

ensure_local_bin_in_path() {
  local bin_dir="${HOME}/.local/bin"
  if path_has_dir "$bin_dir"; then
    return 0
  fi

  local shell="${SHELL:-}"
  if [[ "$shell" == */zsh ]]; then
    append_path_export_once "${HOME}/.zprofile"
    append_path_export_once "${HOME}/.zshrc"
  elif [[ "$shell" == */bash ]]; then
    append_path_export_once "${HOME}/.bash_profile"
    append_path_export_once "${HOME}/.bashrc"
  else
    append_path_export_once "${HOME}/.zprofile"
    append_path_export_once "${HOME}/.zshrc"
    append_path_export_once "${HOME}/.bash_profile"
    append_path_export_once "${HOME}/.bashrc"
  fi

  warn "~/.local/bin is not currently in PATH."
  warn "I added an export line to your shell rc. Open a new terminal or run:"
  warn '  export PATH="$HOME/.local/bin:$PATH"'
}

cmd_install() {
  local bin_dir="${HOME}/.local/bin"
  local target="${bin_dir}/${PROG}"
  mkdir -p "$bin_dir"
  install -m 0755 "$0" "$target"
  echo "Installed to $target"
  ensure_local_bin_in_path
}

cmd_uninstall() {
  local target="${HOME}/.local/bin/${PROG}"
  rm -f "$target"
  echo "Removed $target"
}

cmd_reinstall() {
  cmd_uninstall
  cmd_install
}

# ---------------------------
# Commands
# ---------------------------
main() {
  resolve_dirs
  ensure_dirs

  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    help|-h|--help) usage ;;
    list|ls) list_profiles ;;
    active)
      local a; a="$(get_active_profile)"
      [[ -n "$a" ]] && echo "$a" || die "no active profile (use: $PROG use <name>)"
      ;;
    init)
      local name="${1:-default}"
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"
      set_active_profile "$name"
      echo "Active: $name"
      echo "Opening runtime env: $(profile_runtime_env_path "$name")"
      run_editor "$(profile_runtime_env_path "$name")"
      ;;
    create)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: $PROG create <name>"
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"
      echo "Created: $name"
      ;;
    use|switch)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: $PROG use <name>"
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"

      local current; current="$(get_active_profile)"
      if [[ -n "$current" && "$current" == "$name" ]]; then
        echo "Active: $name (unchanged)"
        exit 0
      fi

      # stop previous active (best-effort)
      if [[ -n "$current" ]]; then
        compose_down_best_effort "$current"
      fi

      set_active_profile "$name"
      echo "Active: $name"
      ;;
    edit)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG edit <name> or $PROG use <name>"
      fi
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"
      run_editor "$(profile_runtime_env_path "$name")"
      ;;
    edit-compose)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG edit-compose <name>"
      fi
      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      ensure_profile_prefilled "$name"
      run_editor "$(profile_compose_env_path "$name")"
      ;;
    up|start|run)
      local requested="${1:-}"
      local current; current="$(get_active_profile)"
      local name

      if [[ -n "$requested" ]]; then
        name="$(sanitize_profile_name "$requested")" || die "invalid profile name (use letters/digits/._-)"
        ensure_profile_prefilled "$name"
        if [[ -n "$current" && "$current" != "$name" ]]; then
          compose_down_best_effort "$current"
        fi
        set_active_profile "$name"
      else
        name="$current"
        [[ -n "$name" ]] || die "no active profile; use: $PROG use <name>"
      fi

      compose_up "$name"
      ;;
    down|stop)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG down <name>"
      else
        name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      fi
      compose_cmd "$name" down --remove-orphans
      ;;
    status)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG status <name>"
      else
        name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      fi
      compose_status "$name"
      ;;
    logs)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        name="$(get_active_profile)"; [[ -n "$name" ]] || die "no active profile; use: $PROG logs <name>"
      else
        name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      fi
      compose_logs "$name"
      ;;
    delete|rm|remove)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: $PROG delete <name> [--yes]"
      shift || true
      local assume_yes="0"
      [[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && assume_yes="1"

      name="$(sanitize_profile_name "$name")" || die "invalid profile name (use letters/digits/._-)"
      local compose_file runtime_file
      compose_file="$(profile_compose_env_path "$name")"
      runtime_file="$(profile_runtime_env_path "$name")"
      [[ -f "$compose_file" || -f "$runtime_file" ]] || die "profile not found: $name"

      if ! confirm "Delete profile '$name' and its profile-owned data (logs/cache/dumps)?" "$assume_yes"; then
        echo "Cancelled."; exit 0
      fi

      local active; active="$(get_active_profile)"
      compose_down_best_effort "$name"

      if [[ "$active" == "$name" ]]; then
        clear_active_profile
      fi

      rm -f "$compose_file" "$runtime_file"
      rm -rf "${PROFILE_CACHE_ROOT:?}/${name}" "${PROFILE_LOG_ROOT:?}/${name}" "${PROFILE_DATA_ROOT:?}/${name}"
      echo "Deleted: $name"
      ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    reinstall) cmd_reinstall ;;
    *)
      usage
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
